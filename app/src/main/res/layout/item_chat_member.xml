<?xml version="1.0" encoding="utf-8"?>
<!-- Chat list row: initials avatar + presence ring + name/status + E2E lock. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- ── Avatar stack: ring (behind) → circle → initials ── -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <View
                android:id="@+id/viewPresenceRing"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_ring"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:contentDescription="@string/nav_chat"/>

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"/>

            <View
                android:id="@+id/onlineIndicator"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_online_dot"
                android:visibility="invisible"/>
        </FrameLayout>

        <!-- ── Name / status ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvLastSeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_muted"/>
        </LinearLayout>

        <!-- ── E2E indicator ── -->
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Encrypted"
            app:tint="@color/accent_cyan"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
