<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Month navigation bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:background="@color/bg_surface">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent_cyan"
                android:contentDescription="Previous month"/>

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"/>

            <!-- Today button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToday"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Today"
                android:textSize="12sp"
                android:textColor="@color/accent_cyan"/>

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent_cyan"
                android:contentDescription="Next month"/>
        </LinearLayout>

        <!-- ── Day-of-week header row ── -->
        <LinearLayout
            android:id="@+id/dowHeader"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="@color/bg_surface">

            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="S" android:gravity="center" android:textSize="12sp" android:textColor="@color/error_red" android:textStyle="bold"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="M" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_muted"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="T" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_muted"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="W" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_muted"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="T" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_muted"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="F" android:gravity="center" android:textSize="12sp" android:textColor="@color/text_muted"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="S" android:gravity="center" android:textSize="12sp" android:textColor="@color/error_red" android:textStyle="bold"/>
        </LinearLayout>

        <!-- ── Calendar grid — programmatically filled, fixed height per row ── -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/calendarGrid"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            app:columnCount="7"
            app:rowCount="6"
            android:background="@color/bg_primary"/>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_surface"/>

        <!-- ── Selected day label ── -->
        <TextView
            android:id="@+id/tvSelectedDayLabel"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:text="Events this month"
            android:textSize="13sp"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold"
            android:background="@color/bg_surface"/>

        <!-- ── Events list ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"/>

        <!-- ── Empty events state ── -->
        <TextView
            android:id="@+id/tvNoEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No events. Tap + to add one."
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:padding="24dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- ── FAB ── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        app:backgroundTint="@color/accent_cyan"
        android:src="@drawable/ic_add"
        app:tint="@color/bg_primary"
        android:contentDescription="Add event"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
