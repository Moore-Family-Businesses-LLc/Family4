<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Branded header bar ── -->
        <com.family4.app.ui.common.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerTitle="Calendar"/>

        <!-- ── Month navigation bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:background="@color/bg_surface">

            <ImageButton
                android:id="@+id/btnPrevMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent_cyan"
                android:contentDescription="Previous month"/>

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Family4.SectionTitle"
                android:textSize="17sp"
                android:gravity="center"/>

            <!-- Today button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToday"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Today"
                android:textSize="12sp"
                android:textColor="@color/accent_cyan"/>

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/accent_cyan"
                android:contentDescription="Next month"/>
        </LinearLayout>

        <!-- ── Day-of-week header row ── -->
        <LinearLayout
            android:id="@+id/dowHeader"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="@color/bg_surface">

            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="SUN" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/error_red" android:textStyle="bold" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="MON" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="TUE" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="WED" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="THU" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="FRI" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/text_muted" android:letterSpacing="0.06"/>
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="SAT" android:gravity="center" android:textSize="10sp"
                android:textColor="@color/error_red" android:textStyle="bold" android:letterSpacing="0.06"/>
        </LinearLayout>

        <!-- ── Calendar grid — programmatically filled ── -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/calendarGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            app:columnCount="7"
            app:rowCount="6"
            android:background="@color/bg_primary"/>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- ── Selected day label with event count chip ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="@color/bg_surface">

            <TextView
                android:id="@+id/tvSelectedDayLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Events this month"
                android:textSize="13sp"
                android:textColor="@color/accent_cyan"
                android:textStyle="bold"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEventCount"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 events"
                android:textSize="11sp"
                app:chipBackgroundColor="@color/bg_elevated"
                app:chipStrokeColor="@color/accent_cyan"
                app:chipStrokeWidth="1dp"
                android:textColor="@color/accent_cyan"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- ── Events list ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:paddingHorizontal="12dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"/>

        <!-- ── Empty events state (logo watermark pattern) ── -->
        <LinearLayout
            android:id="@+id/tvNoEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_logo_small"
                android:alpha="0.15"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No events"
                android:textAppearance="@style/TextAppearance.Family4.CardTitle"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap + to add an event"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ── FAB ── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        app:backgroundTint="@color/accent_cyan"
        android:src="@drawable/ic_add"
        app:tint="@color/bg_primary"
        android:contentDescription="Add event"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
