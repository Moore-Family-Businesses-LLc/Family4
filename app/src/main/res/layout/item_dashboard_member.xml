<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard member strip cell: initials avatar with a live presence ring. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="74dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <View
            android:id="@+id/viewPresenceRing"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_ring"
            android:visibility="gone"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAvatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:scaleType="centerCrop"
            android:contentDescription="@string/nav_home"/>

        <TextView
            android:id="@+id/tvAvatarInitials"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="1dp"
            android:background="@drawable/bg_online_dot"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tvMemberName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Name"/>

</LinearLayout>
