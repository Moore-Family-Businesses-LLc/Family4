<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ── HERO CARD ─────────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Family4.Card.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="@color/accent_cyan"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:src="@drawable/ic_logo_small"
                        android:alpha="0.5"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Greeting row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvGreeting"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Good morning, Family"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:letterSpacing="-0.01"/>

                                <TextView
                                    android:id="@+id/tvDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_muted"
                                    android:layout_marginTop="2dp"/>
                            </LinearLayout>

                            <!-- Live clock -->
                            <TextView
                                android:id="@+id/tvClock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/accent_cyan"
                                android:fontFamily="monospace"/>
                        </LinearLayout>

                        <!-- Accent divider -->
                        <View
                            android:layout_width="48dp"
                            android:layout_height="3dp"
                            android:background="@color/accent_cyan"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="16dp"/>

                        <!-- Stats row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Online -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvOnlineCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="–"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_green"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Online"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted"/>
                            </LinearLayout>

                            <!-- Divider -->
                            <View android:layout_width="1dp" android:layout_height="40dp"
                                android:background="@color/divider"/>

                            <!-- Events -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvEventCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="–"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_cyan"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Events today"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted"/>
                            </LinearLayout>

                            <!-- Divider -->
                            <View android:layout_width="1dp" android:layout_height="40dp"
                                android:background="@color/divider"/>

                            <!-- Tasks -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvTaskCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="–"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/accent_purple"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tasks pending"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_muted"/>
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── FAMILY MEMBERS strip ───────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAMILY"
                    android:textAppearance="@style/TextAppearance.Family4.Label"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMembers"
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:layout_marginBottom="20dp"
                    android:paddingHorizontal="12dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"/>

                <!-- ── QUICK ACCESS label ─────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="QUICK ACCESS"
                        android:textAppearance="@style/TextAppearance.Family4.Label"/>

                    <TextView
                        android:id="@+id/tvLastActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/accent_cyan"/>
                </LinearLayout>

                <!-- ── QUICK ACTION GRID — 2×5 ───────────────────────── -->
                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="12dp"
                    app:columnCount="2"
                    app:rowCount="5">

                    <!-- Notes -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardNotes"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="16dp">
                            <!-- Accent strip marks the primary quick actions -->
                            <View android:layout_width="3dp" android:layout_height="match_parent"
                                android:background="@color/accent_green"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="📝" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:text="Notes" android:textSize="14sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/tvNotesCount"
                                    android:text="tap to open"
                                    android:textSize="11sp" android:textColor="@color/text_muted"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Calendar -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCalendar"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="16dp">
                            <!-- Accent strip marks the primary quick actions -->
                            <View android:layout_width="3dp" android:layout_height="match_parent"
                                android:background="@color/accent_cyan"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="📅" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:text="Calendar" android:textSize="14sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/tvCalendarNext"
                                    android:text="no events"
                                    android:textSize="11sp" android:textColor="@color/text_muted"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Files -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFiles"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="📁" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Files" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Walkie-Talkie -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWalkie"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="📻" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Walkie" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Emergency SOS — full width accent card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSos"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        app:layout_columnSpan="2"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="#1FFF4444"
                        app:strokeColor="@color/error_red"
                        app:strokeWidth="1dp"
                        app:cardElevation="4dp"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
                            <TextView android:text="🆘" android:textSize="28sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"/>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:text="Emergency SOS"
                                    android:textSize="15sp" android:textStyle="bold"
                                    android:textColor="@color/error_red"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:text="Hold 3 seconds to activate"
                                    android:textSize="11sp" android:textColor="@color/text_muted"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                            <TextView android:text="›"
                                android:textSize="22sp" android:textColor="@color/error_red"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Health -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHealth"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="❤️" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Health" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Albums -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAlbums"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="🖼️" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Albums" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Weather -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWeather"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="🌤️" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Weather" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tasks -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardTasks"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="16dp">
                            <!-- Accent strip marks the primary quick actions -->
                            <View android:layout_width="3dp" android:layout_height="match_parent"
                                android:background="@color/accent_purple"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="✅" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView android:text="Tasks" android:textSize="14sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                                <TextView android:id="@+id/tvTasksBadge"
                                    android:text=""
                                    android:textSize="11sp" android:textColor="@color/accent_purple"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Settings -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSettings"
                        style="@style/Widget.Family4.Card"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="5dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
                            <TextView android:text="⚙️" android:textSize="26sp"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginEnd="12dp"/>
                            <TextView android:text="Settings" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </androidx.gridlayout.widget.GridLayout>

                <!-- ── RECENT ACTIVITY strip ──────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECENT ACTIVITY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/text_muted"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llActivityFeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"/>

            </LinearLayout>
        </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
