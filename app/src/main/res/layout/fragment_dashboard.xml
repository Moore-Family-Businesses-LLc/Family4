<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard / Home Fragment -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good morning, Family 👋"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <!-- Online / Status row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvOnlineCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— online"
                android:textSize="13sp"
                android:textColor="@color/online_green"/>

            <TextView
                android:id="@+id/tvEventCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— events today"
                android:textSize="13sp"
                android:textColor="@color/text_muted"/>

        </LinearLayout>

        <!-- Members strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMembers"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"/>

        <!-- Quick action grid — 2 columns -->
        <TextView
            android:text="Quick Access"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="2"
            app:rowCount="5"
            android:layout_marginBottom="16dp">

            <!-- Notes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNotes"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="📝" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Notes" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Calendar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendar"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="📅" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Calendar" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Files -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiles"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="📁" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Files" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Walkie-Talkie -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWalkie"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="📻" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Walkie-Talkie" android:textSize="11sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Emergency SOS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSos"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                app:cardBackgroundColor="#3AFF0000"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="🆘" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="SOS" android:textSize="13sp" android:textColor="@color/error_red" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Health -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHealth"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="❤️" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Health" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Albums -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlbums"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="🖼️" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Albums" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weather -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeather"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="🌤️" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Weather" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tasks -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTasks"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="✅" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:id="@+id/tvTaskCount" android:text="Tasks" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                style="@style/Widget.Family4.Card"
                android:layout_width="0dp"
                android:layout_height="100dp"
                app:layout_columnWeight="1"
                android:layout_margin="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:text="⚙️" android:textSize="28sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Settings" android:textSize="13sp" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.gridlayout.widget.GridLayout>

    </LinearLayout>

</ScrollView>
