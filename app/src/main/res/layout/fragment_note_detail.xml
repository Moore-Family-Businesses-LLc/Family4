<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noteDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Scrollable editing area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Note title — paddingTop accounts for the back arrow toolbar -->
            <EditText
                android:id="@+id/etNoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_title_hint"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@android:color/transparent"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:inputType="textCapSentences"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="16dp"/>

            <!-- Note body -->
            <EditText
                android:id="@+id/etNoteContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="240dp"
                android:hint="@string/note_content_hint"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.35"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@android:color/transparent"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom toolbar (Keep-style action bar) -->
    <LinearLayout
        android:id="@+id/noteDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/bg_surface"
        app:elevation="8dp">

        <!-- Add image/checklist (keep as add) -->
        <ImageView
            android:id="@+id/btnNoteAddItem"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_add"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add item"
            android:padding="12dp"/>

        <!-- Pin toggle -->
        <ImageView
            android:id="@+id/btnNotePin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pin"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pin note"
            android:padding="12dp"/>

        <!-- Colour palette toggle -->
        <ImageView
            android:id="@+id/btnNoteColorPalette"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_color_palette"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Note colour"
            android:padding="12dp"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- Delete -->
        <ImageView
            android:id="@+id/btnNoteDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete note"
            android:padding="12dp"/>

        <!-- Last edited timestamp -->
        <TextView
            android:id="@+id/tvNoteEdited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:layout_marginEnd="8dp"/>

    </LinearLayout>

    <!-- Colour picker panel (slides up from bottom, hidden by default) -->
    <HorizontalScrollView
        android:id="@+id/colorPickerPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:background="@color/bg_elevated"
        android:scrollbars="none"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:id="@+id/colorPickerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>

    </HorizontalScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
