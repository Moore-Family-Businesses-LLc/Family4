<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- ── Channel + Status bar ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/channelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="Family Channel"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvChannelName"
                            android:text="Family4 — All Members"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                    <!-- Encryption indicator -->
                    <LinearLayout
                        android:id="@+id/encryptionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip_cyan"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvEncryptIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvEncryptLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" AES-256"
                            android:textSize="10sp"
                            android:textColor="@color/accent_cyan"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Channel lock toggle -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchChannelLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Lock channel"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/bg_elevated"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Signal + Peer count row ────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <!-- Signal strength bars -->
                <TextView
                    android:text="Signal: "
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/signalBars"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginEnd="16dp">

                    <View android:id="@+id/bar1"
                        android:layout_width="6dp" android:layout_height="6dp"
                        android:layout_marginEnd="2dp"
                        android:background="@color/accent_cyan"/>
                    <View android:id="@+id/bar2"
                        android:layout_width="6dp" android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:background="@color/accent_cyan"/>
                    <View android:id="@+id/bar3"
                        android:layout_width="6dp" android:layout_height="14dp"
                        android:layout_marginEnd="2dp"
                        android:background="@color/accent_cyan"/>
                    <View android:id="@+id/bar4"
                        android:layout_width="6dp" android:layout_height="18dp"
                        android:background="@color/text_disabled"/>

                </LinearLayout>

                <!-- Peer count badge -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPeerCount"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 peers"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/bg_elevated"
                    app:chipStrokeColor="@color/accent_purple"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/accent_purple"/>

                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1"/>

                <!-- Transmission timer -->
                <TextView
                    android:id="@+id/tvTxTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan"
                    android:visibility="invisible"/>

            </LinearLayout>

            <!-- ── Online members ─────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Members"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOnlineMembers"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:paddingHorizontal="16dp"/>

            <!-- ── Waveform ────────────────────────────────────────── -->
            <com.family4.app.ui.walkie.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <!-- ── VAD mic-level meter ───────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mic Level"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted"/>

                        <TextView
                            android:id="@+id/tvMicLevelPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_cyan"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressMicLevel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent_cyan"
                        android:progressBackgroundTint="@color/bg_elevated"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Squelch control ───────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Squelch"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="10dp"/>

                    <SeekBar
                        android:id="@+id/seekSquelch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10"
                        android:progress="3"
                        android:progressTint="@color/accent_cyan"
                        android:thumbTint="@color/accent_cyan"/>

                    <TextView
                        android:id="@+id/tvSquelchValue"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="13sp"
                        android:textColor="@color/accent_cyan"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginStart="8dp"/>

                    <!-- Noise suppression toggle -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNoiseSuppression"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NS"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        app:thumbTint="@color/accent_green"
                        app:trackTint="@color/bg_elevated"
                        android:layout_marginStart="12dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Audio codec selector ──────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio Quality"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCodec"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCodecNarrow"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Narrow 8k"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_cyan"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/text_secondary"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCodecWide"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wide 16k"
                            android:checked="true"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_cyan"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/text_secondary"/>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCodecHd"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HD 48k"
                            android:textSize="12sp"
                            app:chipBackgroundColor="@color/bg_elevated"
                            app:chipStrokeColor="@color/accent_cyan"
                            app:chipStrokeWidth="1dp"
                            android:textColor="@color/text_secondary"/>

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Last-Heard log ────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Last Heard"
                            android:textSize="12sp"
                            android:textColor="@color/text_muted"/>

                        <TextView
                            android:id="@+id/tvLastHeardEmpty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No transmissions yet"
                            android:textSize="11sp"
                            android:textColor="@color/text_disabled"
                            android:visibility="visible"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llLastHeardEntries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Incoming / status label ───────────────────────── -->
            <TextView
                android:id="@+id/incomingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● INCOMING"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp"/>

            <!-- ── PTT control ──────────────────────────────────────
                 Lives INSIDE the scroll content: at 170dp floating it
                 covered the Last-Heard log and the squelch/codec cards. -->
            <FrameLayout
                android:id="@+id/pttContainer"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp">

                <View
                    android:id="@+id/pttRing"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ptt_ring"/>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnPtt"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_walkie"
                    android:contentDescription="@string/ptt_hold_to_talk"
                    app:backgroundTint="@color/accent_cyan"
                    app:tint="@color/bg_primary"
                    app:fabCustomSize="72dp"
                    app:maxImageSize="32dp"
                    app:elevation="10dp"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvPttStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ptt_hold_to_talk"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
