<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Channel indicator bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/channelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="Family Channel"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvChannelName"
                android:text="Family4 — All Members"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Online members row -->
    <TextView
        android:id="@+id/tvOnlineLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Online"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/channelCard"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOnlineMembers"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvOnlineLabel"/>

    <!-- Waveform / audio visualizer -->
    <com.family4.app.ui.walkie.WaveformView
        android:id="@+id/waveformView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/rvOnlineMembers"
        app:layout_constraintBottom_toTopOf="@id/btnPtt"/>

    <!-- Incoming indicator -->
    <TextView
        android:id="@+id/incomingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● INCOMING"
        android:textColor="#00D4FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnPtt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

    <!-- PTT status label -->
    <TextView
        android:id="@+id/tvPttStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hold to Talk"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/btnPtt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="64dp"/>

    <!-- Giant PTT button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPtt"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:text="PTT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/accent_blue"
        app:cornerRadius="90dp"
        app:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="64dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
