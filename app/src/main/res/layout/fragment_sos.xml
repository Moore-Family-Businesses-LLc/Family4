<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- SOS icon -->
    <ImageView
        android:id="@+id/ivSosIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_sos_alert"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="SOS"/>

    <TextView
        android:id="@+id/tvSosTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sos_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/error_red"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ivSosIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSosSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sos_subtitle"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSosTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--
        Hold button + circular countdown ring — stacked in a FrameLayout
        so the ring sits precisely behind the button.
        The ProgressBar uses a custom ring drawable (bg_sos_ring) that draws
        a circular arc starting at the 12-o'clock position.
    -->
    <FrameLayout
        android:id="@+id/sosButtonContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="180dp">

        <!-- Circular countdown ring -->
        <ProgressBar
            android:id="@+id/progressSOS"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_sos_ring"
            android:indeterminate="false"/>

        <!-- Big SOS hold button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSOS"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:text="SOS"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/error_red"
            app:cornerRadius="80dp"
            app:elevation="16dp"/>

    </FrameLayout>

    <!-- Status hint shown below the button -->
    <TextView
        android:id="@+id/tvHoldHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sos_hold_hint"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/sosButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- Countdown timer label — visible only while counting down -->
    <TextView
        android:id="@+id/tvSosCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/error_red"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/sosButtonContainer"
        app:layout_constraintBottom_toBottomOf="@id/sosButtonContainer"
        app:layout_constraintStart_toStartOf="@id/sosButtonContainer"
        app:layout_constraintEnd_toEndOf="@id/sosButtonContainer"/>

    <!-- CANCEL label — appears below hint while counting -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:strokeColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/tvHoldHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddContact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage Emergency Contacts"
        app:backgroundTint="@color/bg_surface"
        android:textColor="@color/text_secondary"
        app:strokeColor="@color/accent_blue"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
