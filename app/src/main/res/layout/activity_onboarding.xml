<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ─── Step Progress Dots ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/stepDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp">

        <View android:id="@+id/stepIndicator1" android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/bg_step_dot" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/stepIndicator2" android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/bg_step_dot" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/stepIndicator3" android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/bg_step_dot"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStepCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 3"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        app:layout_constraintTop_toBottomOf="@id/stepDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <!-- ─── STEP 1: Welcome ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/panelWelcome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvStepCount"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_logo_family4"
            android:contentDescription="Family4 Logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAMILY4"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="@color/text_primary"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay Connected. Stay Safe. Stay Together."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your family in one beautiful, secure app."
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

        <!-- Feature highlights row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="32dp">
            <TextView android:text="📷" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
            <TextView android:text="💬" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
            <TextView android:text="📻" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
            <TextView android:text="🗺️" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
            <TextView android:text="🆘" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
            <TextView android:text="🤖" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="10dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ─── STEP 2: Profile ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/panelProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvStepCount"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons">

        <TextView android:text="👋 Welcome!" android:textSize="28sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Tell us a bit about yourself"
            android:textSize="14sp" android:textColor="@color/text_muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:layout_marginBottom="32dp"/>

        <!-- Avatar -->
        <FrameLayout android:layout_width="88dp" android:layout_height="88dp" android:layout_marginBottom="20dp">
            <ImageView android:id="@+id/ivOnboardingAvatar"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_avatar_default" android:background="@drawable/bg_avatar_circle"
                android:padding="16dp" android:tint="@color/accent_cyan" android:contentDescription="Avatar"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabPickAvatar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|end" android:src="@drawable/ic_add"
                app:backgroundTint="@color/accent_cyan" app:tint="@color/bg_primary"
                app:maxImageSize="16dp" android:contentDescription="Pick avatar"/>
        </FrameLayout>

        <!-- Display name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Your Name *"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/accent_cyan" app:hintTextColor="@color/text_muted">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDisplayName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Family invite code -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Family Invite Code (optional)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/accent_cyan" app:hintTextColor="@color/text_muted"
            android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInviteCode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="textAllCaps" android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:text="Already have a family group? Enter the code from a family member."
            android:textSize="11sp" android:textColor="@color/text_muted"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- ─── STEP 3: Connect ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/panelConnect"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvStepCount"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons">

        <TextView android:text="🔗 Connect Your Account"
            android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Sign in with Google to enable Drive backup and sync"
            android:textSize="13sp" android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:layout_marginBottom="28dp"/>

        <!-- Google Sign-In button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Sign in with Google"
            app:icon="@drawable/ic_google_logo"
            app:iconPadding="12dp"
            app:backgroundTint="#FFFFFFFF"
            android:textColor="#1F2328"
            app:strokeColor="#E5E7EB" app:strokeWidth="1dp"
            app:cornerRadius="28dp"/>

        <TextView android:id="@+id/tvGoogleAccount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/accent_green"
            android:visibility="gone" android:layout_marginTop="8dp"/>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="24dp"/>

        <!-- Permissions -->
        <TextView android:text="📍 App Permissions"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <TextView android:text="Camera, microphone, location, and notifications are needed for all features."
            android:textSize="12sp" android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Grant Permissions"
            app:backgroundTint="@color/bg_surface"
            android:textColor="@color/accent_cyan"
            app:strokeColor="@color/accent_cyan" app:strokeWidth="1dp"
            app:cornerRadius="24dp"/>

        <TextView android:id="@+id/tvPermissionStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_muted"
            android:layout_marginTop="8dp"/>

        <!-- Drive info -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Family4.Card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_upload" android:tint="@color/accent_cyan"
                    android:contentDescription="Drive" android:layout_marginEnd="12dp"/>
                <TextView android:text="Your data is backed up to:\nGoogle Drive / Family4_AppData"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ─── Bottom Navigation Buttons ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Back"
            app:backgroundTint="@color/bg_surface"
            android:textColor="@color/text_secondary"
            app:cornerRadius="24dp"
            android:visibility="gone"/>

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Continue"
            android:paddingHorizontal="32dp"
            app:backgroundTint="@color/accent_cyan"
            android:textColor="@color/bg_primary"
            android:textStyle="bold"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
