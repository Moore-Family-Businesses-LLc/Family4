<?xml version="1.0" encoding="utf-8"?>
<!--
    PIN lock overlay — shown on top of whatever was underneath when the app
    was backgrounded. Uses a dark, full-screen opaque background so the
    content behind it is fully hidden.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_primary"
    android:padding="32dp">

    <!-- Logo watermark -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_logo"
        android:alpha="0.9"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="0.08"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_enter_prompt"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="32dp"/>

    <!-- PIN dot row — shows filled/empty circles as user types -->
    <LinearLayout
        android:id="@+id/pinDotRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp"/>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pin_incorrect"
        android:textSize="13sp"
        android:textColor="@color/error_red"
        android:visibility="invisible"
        android:layout_marginBottom="20dp"/>

    <!-- 3×4 numpad grid -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/pinNumpad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:columnCount="3"
        app:rowCount="4"
        app:useDefaultMargins="false"/>

</LinearLayout>
