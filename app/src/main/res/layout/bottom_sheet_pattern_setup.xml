<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Stealth Unlock Pattern"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvPatternInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Draw a new unlock pattern"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <com.family4.app.ui.stealth.PatternLockView
        android:id="@+id/patternSetupView"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Draw at least 4 dots"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:layout_marginTop="8dp"/>
</LinearLayout>
