<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">
    <com.family4.app.ui.common.SectionHeaderView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:headerTitle="Bedtime Alerts"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBedtimes"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="8dp" android:clipToPadding="false"/>
</LinearLayout>
