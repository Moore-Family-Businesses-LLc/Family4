<?xml version="1.0" encoding="utf-8"?>
<!--
    Family4 compact mark — 28dp, for toolbars, section headers and watermarks.
    Deliberately NOT a scaled-down ic_logo: the badge composition collapses
    below ~32dp, so here the two figures sit left and the numeral sits beside
    them at full height, which stays readable down to 20dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="28dp"
    android:height="28dp"
    android:viewportWidth="32"
    android:viewportHeight="32">

    <!-- Navy rounded-square field -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M0,7A7,7 0,0 1,7 0H25A7,7 0,0 1,32 7V25A7,7 0,0 1,25 32H7A7,7 0,0 1,0 25V7z"/>

    <!-- Connection arc over the pair -->
    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M5.5,8 Q11.5,3.6 17.5,8"/>

    <!-- Left figure — cyan -->
    <path
        android:fillColor="#00D4FF"
        android:pathData="M8.5,11.4m-2.4,0a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0"/>
    <path
        android:fillColor="#00D4FF"
        android:pathData="M5,19.4v-2.2a3.5,3.5 0,0 1,7 0v2.2z"/>

    <!-- Right figure — purple -->
    <path
        android:fillColor="#7B2FFF"
        android:pathData="M14.5,11.4m-2.4,0a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0"/>
    <path
        android:fillColor="#7B2FFF"
        android:pathData="M11,19.4v-2.2a3.5,3.5 0,0 1,7 0v2.2z"/>

    <!-- The numeral 4, beside the pair — the anchor at small sizes -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M25,8.5 L20.2,16.5 L29.4,16.5"/>
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M26,8.5 V22"/>
</vector>
