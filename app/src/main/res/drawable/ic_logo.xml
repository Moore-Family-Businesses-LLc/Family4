<?xml version="1.0" encoding="utf-8"?>
<!--
    Family4 primary mark — 96dp, for splash and About.
    Composition: navy rounded square, halo ring, two figures (cyan + purple)
    joined by a connection arc, and a "4" badge anchored bottom-right.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Navy rounded-square field -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M0,20A20,20 0,0 1,20 0H76A20,20 0,0 1,96 20V76A20,20 0,0 1,76 96H20A20,20 0,0 1,0 76V20z"/>

    <!-- Inner halo — faint cyan ring centred on the mark -->
    <path
        android:strokeColor="#1F00D4FF"
        android:strokeWidth="7"
        android:fillColor="#00000000"
        android:pathData="M48,46m-36,0a36,36 0,1 0,72 0a36,36 0,1 0,-72 0"/>

    <!-- Connection arc over both figures -->
    <path
        android:strokeColor="#00D4FF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M28,26 Q48,8 68,26"/>

    <!-- Left figure — cyan -->
    <path
        android:fillColor="#00D4FF"
        android:pathData="M35,34m-8,0a8,8 0,1 0,16 0a8,8 0,1 0,-16 0"/>
    <path
        android:fillColor="#00D4FF"
        android:pathData="M23,62v-8a12,12 0,0 1,24 0v8z"/>

    <!-- Right figure — purple -->
    <path
        android:fillColor="#7B2FFF"
        android:pathData="M61,34m-8,0a8,8 0,1 0,16 0a8,8 0,1 0,-16 0"/>
    <path
        android:fillColor="#7B2FFF"
        android:pathData="M49,62v-8a12,12 0,0 1,24 0v8z"/>

    <!-- Badge behind the numeral so it stays legible over the figures -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M68,70m-22,0a22,22 0,1 0,44 0a22,22 0,1 0,-44 0"/>
    <path
        android:strokeColor="#4D00D4FF"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M68,70m-21,0a21,21 0,1 0,42 0a21,21 0,1 0,-42 0"/>

    <!-- The numeral 4 — the wordmark anchor, kept as bold strokes -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M70,58 L57,74 L81,74"/>
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M72,58 V84"/>
</vector>
